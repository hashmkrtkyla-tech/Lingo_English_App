EOF
python3 -c "
import json
with open('/tmp/practice/medium_sentences.json') as f: d=json.load(f)
print('العدد النهائي:', len(d))
seen=set(); dups=[]
for s in d:
    en = s['sentences']['en'].strip().lower()
    if en in seen: dups.append(en)
    seen.add(en)
print('تكرار:', len(dups), dups)
"
